d=json.load(open('nb_all.json'))
flags=['sliding_window','layer_types','indexer','mla','kv_lora_rank','q_lora_rank','sparse','attention_sink','num_sinks','use_sliding_window']
import urllib.request, concurrent.futures
def check(m):
    rid=m['id']
    for f in ('config.json',):
        try:
            with urllib.request.urlopen(f"https://huggingface.co/{rid}/raw/main/{f}", timeout=20) as r:
                c=json.load(r)
        except Exception as e:
            return rid, 'ERR '+str(e)[:40], None
        hits={k:c[k] for k in flags if k in c and c[k] not in (None, [], False)}
        lt=c.get('layer_types')
        return rid, hits, (lt[:6] if isinstance(lt,list) else lt)
with concurrent.futures.ThreadPoolExecutor(max_workers=12) as ex:
    for rid,hits,lt in ex.map(check, d):
        print(rid, '|', hits, '| layer_types:', lt)
