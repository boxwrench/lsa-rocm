shapes=collections.defaultdict(set)
for i in range(1,15):
    fn=f"model-{i:05d}-of-00014.safetensors"
    b=subprocess.run(["curl","-sL","-r","0-7",base+fn],capture_output=True).stdout
    n=struct.unpack("<Q",b)[0]
    h=json.loads(subprocess.run(["curl","-sL","-r",f"8-{7+n}",base+fn],capture_output=True).stdout)
    for k,v in h.items():
        if k=='__metadata__': continue
        suf=k.split('.',3)[3] if k.startswith('model.layers.') else k
        shapes[suf].add(tuple(v['shape']))
for s in sorted(shapes): print(s, shapes[s])
