import struct
b=open('gguf_head.bin','rb').read()
off=4
def u32():
    global off
    v,=struct.unpack_from('<I',b,off); off+=4; return v
def u64():
    global off
    v,=struct.unpack_from('<Q',b,off); off+=8; return v
def stri():
    global off
    n=u64(); v=b[off:off+n].decode('utf-8','replace'); off+=n; return v
ver=u32(); nt=u64(); nkv=u64()
print('ver',ver,'nt',nt,'nkv',nkv)
sizes={0:1,1:1,2:2,3:2,4:4,5:4,6:4,7:1,10:8,11:8,12:8}
out={}
for _ in range(nkv):
    k=stri(); t=u32()
    if t==8: v=stri()
    elif t==9:
        et=u32(); n=u64()
        if et==8:
            arr=[stri() for _ in range(n)]
            v=arr if len(arr)<=8 else arr[:8]+['...(%d)'%n]
        else:
            off+=sizes[et]*n; v='<%d elems type %d>'%(n,et)
    elif t in (0,1): v,=struct.unpack_from('<B',b,off); off+=1
    elif t in (2,3): v,=struct.unpack_from('<H',b,off); off+=2
    elif t in (4,5,6,7): v,=struct.unpack_from('<I',b,off); off+=4
    elif t==10: v=u64()
    elif t==11: v,=struct.unpack_from('<q',b,off); off+=8
    elif t==12: v,=struct.unpack_from('<d',b,off); off+=8
    else: raise SystemExit('type %d key %s'%(t,k))
    out[k]=v
for k,v in out.items(): print(k,'=',v)
