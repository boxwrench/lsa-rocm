    60	def apply_rotary_pos_emb(q, k, cos, sin, unsqueeze_dim=1):
    61	    """Applies Rotary Position Embedding to the query and key tensors.
    62	
    63	    Args:
    64	        q (`torch.Tensor`): The query tensor.
    65	        k (`torch.Tensor`): The key tensor.
    66	        cos (`torch.Tensor`): The cosine part of the rotary embedding.
    67	        sin (`torch.Tensor`): The sine part of the rotary embedding.
    68	        unsqueeze_dim (`int`, *optional*, defaults to 1):
    69	            The 'unsqueeze_dim' argument specifies the dimension along which to unsqueeze cos[position_ids] and
    70	            sin[position_ids] so that they can be properly broadcasted to the dimensions of q and k. For example, note
    71	            that cos[position_ids] and sin[position_ids] have the shape [batch_size, seq_len, head_dim]. Then, if q and
    72	            k have the shape [batch_size, heads, seq_len, head_dim], then setting unsqueeze_dim=1 makes
    73	            cos[position_ids] and sin[position_ids] broadcastable to the shapes of q and k. Similarly, if q and k have
    74	            the shape [batch_size, seq_len, heads, head_dim], then set unsqueeze_dim=2.
    75	    Returns:
    76	        `tuple(torch.Tensor)` comprising of the query and key tensors rotated using the Rotary Position Embedding.
    77	    """
    78	    cos = cos.unsqueeze(unsqueeze_dim)
    79	    sin = sin.unsqueeze(unsqueeze_dim)
    80	    q_embed = (q * cos) + (rotate_half(q) * sin)
