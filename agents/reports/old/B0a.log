52	def rotate_half(x):
    53	    """Rotates half the hidden dims of the input."""
    54	    x1 = x[..., : x.shape[-1] // 2]
    55	    x2 = x[..., x.shape[-1] // 2 :]
    56	    return torch.cat((-x2, x1), dim=-1)
