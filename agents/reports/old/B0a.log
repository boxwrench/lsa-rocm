   198	def _classify_base_weights(
   199	    base_state_dict: dict[str, torch.Tensor],
   200	    arch: ArchDescriptor,
   201	    lora_target_modules: list[str],
   202	):
   203	    """Classify every base model weight into fusion collections or direct mappings.
   204	
   205	    Returns:
   206	        ``(fused_collections, base_to_switch)`` — fused_collections maps
   207	        ``(layer_idx, target_name)`` to collected tensors; base_to_switch
   208	        maps base param names to their switch model counterparts.
   209	    """
   210	    # Build lookup structures from groups
   211	    source_to_group: dict[str, object] = {}  # peft_module -> ModuleDescriptor
   212	    fusion_names = set()
   213	    for g in arch.groups:
   214	        if g.is_base_fusion:
   215	            fusion_names.add(g.name)
   216	            for src in g.peft_modules:
   217	                source_to_group[src] = g
   218	
   219	    fused_collections: dict = {}
   220	    base_to_switch: dict[str, str] = {}
   221	
   222	    for base_name in base_state_dict.keys():
   223	        matched = False
   224	
   225	        # (A) Fusion source? (q_proj, k_proj, v_proj, gate_proj, up_proj)
   226	        for src_module, g in source_to_group.items():
   227	            if f".{src_module}.weight" in base_name:
   228	                layer_match = re.search(arch.layer_pattern, base_name)
   229	                if layer_match:
   230	                    layer_idx = layer_match.group(1)
   231	                    key = (layer_idx, g.name)
   232	                    if key not in fused_collections:
   233	                        fused_collections[key] = {"source_names": []}
   234	                    fused_collections[key][src_module] = base_state_dict[base_name]
   235	                    fused_collections[key]["source_names"].append(base_name)
   236	                    matched = True
   237	                break  # src_module matched the name pattern; stop checking others
   238	
   239	        if matched:
   240	            continue
   241	
   242	        # (B) Already-fused target? (e.g., gate_up_proj.weight)
   243	        already_fused = False
   244	        for target in fusion_names:
   245	            if f".{target}.weight" in base_name:
   246	                layer_match = re.search(arch.layer_pattern, base_name)
   247	                if layer_match:
   248	                    layer_idx = layer_match.group(1)
   249	                    key = (layer_idx, target)
   250	                    if key not in fused_collections:
   251	                        fused_collections[key] = {"source_names": []}
   252	                    fused_collections[key]["fused"] = base_state_dict[base_name]
   253	                    fused_collections[key]["source_names"].append(base_name)
   254	                    already_fused = True
   255	                break
   256	
   257	        if already_fused:
   258	            continue
   259	
   260	        # (C) Standalone LoRA target module? (o_proj, down_proj)
   261	        is_standalone = False
   262	        for g in arch.groups:
   263	            if g.is_base_fusion:
   264	                continue
   265	            src_name = g.peft_modules[0]
   266	            if f".{src_name}.weight" in base_name:
   267	                # Verify the weight belongs to the expected parent module.
   268	                # Without this, MoE expert weights (e.g.,
   269	                # block_sparse_moe.experts.N.input_linear) falsely match
   270	                # shared_mlp groups that also use "input_linear".
   271	                if f".{g.effective_source_parent}." not in base_name:
   272	                    break  # Wrong parent — fall through to (D)
   273	                layer_match = re.search(arch.layer_pattern, base_name)
   274	                if layer_match:
   275	                    layer_idx = layer_match.group(1)
   276	                    target_attr = g.effective_attr_name
   277	                    inner = g.target_inner_path
   278	                    if g.name in lora_target_modules:
   279	                        switch_name = (
   280	                            f"model.layers.{layer_idx}.{g.parent}.{target_attr}."
   281	                            f"{inner}base_layer.weight"
   282	                        )
   283	                    else:
   284	                        switch_name = (
   285	                            f"model.layers.{layer_idx}.{g.parent}.{target_attr}.weight"
   286	                        )
   287	                    base_to_switch[base_name] = switch_name
   288	                    is_standalone = True
   289	                break
   290	
   291	        if is_standalone:
   292	            continue
   293	
   294	        # (D) Everything else: direct mapping (embeddings, norms, lm_head)
   295	        base_to_switch[base_name] = base_name
   296	
   297	    return fused_collections, base_to_switch
