   589	    if result.split_type == "duplicate":
   590	        # lora_A: same input projection for all slices
   591	        for i in range(n):
   592	            slice_name = f"{base_name}.{i}"
   593	            _ensure_stacked(
   594	                stacked, slice_name, True, tensor, num_adapters, max_lora_rank
   595	            )
   596	            stacked[slice_name][adapter_idx, 0, :adapter_rank, :] = tensor
   597	
   598	    elif result.split_type == "chunk_dim0":
   599	        # lora_B: split output dimension across slices
   600	        chunks = tensor.chunk(n, dim=0)
   601	        scaling_factor = adapter_alpha / adapter_rank
   602	        for i, chunk in enumerate(chunks):
   603	            slice_name = f"{base_name}.{i}"
   604	            _ensure_stacked(
   605	                stacked, slice_name, False, chunk, num_adapters, max_lora_rank
   606	            )
   607	            stacked[slice_name][adapter_idx, 0, :, :adapter_rank] = (
   608	                chunk * scaling_factor
