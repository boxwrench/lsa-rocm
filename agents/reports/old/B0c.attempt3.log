import sys, time, torch, torch.nn.functional as F
import lsa, lsa.core as c
print("python", sys.version.split()[0])
print("torch", torch.__version__, "cuda_available", torch.cuda.is_available())
print("lsa", lsa.__version__, "from", lsa.__file__)
torch.manual_seed(0)
keys = F.normalize(torch.randn(8192 + 20, 64), dim=-1)
b = c.build_buckets(keys, 4, 8, 16, 512)
print("build_buckets", tuple(b.bucket_centroids.shape), tuple(b.bucket_members.shape),
      "block_bucket_count", b.block_bucket_count)
q = F.normalize(torch.randn(4, 64), dim=-1)
pos = torch.tensor([200, 4096, 8191, 8191])
sel, ln = c.read(q, pos, b, top_p=16, top_k=64, sink_size=4, window_size=512)
print("read", tuple(sel.shape), ln.tolist(), "dtype", sel.dtype)
# full-budget read covers every causal position exactly once
sel, ln = c.read(keys[8191:8192], torch.tensor([8191]), b, top_p=b.bucket_centroids.shape[0],
                 top_k=8192, sink_size=4, window_size=512)
covered = sel[0, :ln[0]].long()
print("full-budget read length", int(ln[0]), "unique", covered.unique().numel(), "max", int(covered.max()))
# topk_attention at a full budget reproduces dense causal attention
T, H, D = 40, 4, 8
qq = torch.randn(1, T, H, D); kk = torch.randn(1, T, H, D); vv = torch.randn(1, T, H, D)
ids = torch.arange(T, dtype=torch.int32)[None, None, :].expand(1, T, T).contiguous()
out = c.topk_attention(qq, kk, vv, ids, window=T, sink=T, scale=0.35)
dense = F.scaled_dot_product_attention(qq.transpose(1, 2), kk.transpose(1, 2), vv.transpose(1, 2),
                                       is_causal=True, scale=0.35).transpose(1, 2)
print("topk_attention max |diff vs SDPA|", (out - dense).abs().max().item())
# hierarchy on CPU
h = c.build_hierarchy(keys, b, 2, 4, 4096)
print("build_hierarchy levels", len(h.node_centroids), [tuple(t.shape) for t in h.node_centroids])
s2, l2, sc = c.read_hierarchy_counted(q, pos, b, h, 4, None, 16, 64, 4, 512, 8192, 0)
print("read_hierarchy_counted", tuple(s2.shape), l2.tolist(), "scored", sc.tolist())
# index-space helpers
qf = torch.randn(1, 8, 5, 64); kf = torch.randn(1, 2, 5, 64)
rq, rk = c.position_free(qf, kf, c.RotaryLayout("prefix", 16))
gq, gk = c.regroup(qf, kf)
print("position_free", tuple(rq.shape), tuple(rk.shape), "regroup", tuple(gq.shape), tuple(gk.shape))
